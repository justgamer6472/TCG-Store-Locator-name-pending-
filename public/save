/* * {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #111318;
    color: #f4f4f4;
}

header {
    background: #1a1d24;
    border-bottom: 1px solid #30343d;
}

nav {
    max-width: 1100px;
    margin: auto;
    padding: 18px 24px;
}

main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 24px;
}

.logo {
    color: white;
    text-decoration: none;
    font-size: 1.3rem;
    font-weight: bold; 
}

.hero {
    margin-bottom: 40px;
}

.hero h1 {
    font-size: 2.5rem;
    margin-bottom: 10px;
}

.hero p {
    color: #b9bec8;
}

.search-form {
    display: flex;
    gap: 10px;
    margin-top: 24px;
}

.search-form input {
    flex: 1;
    padding: 14px;
    border: 1px solid #3c414c;
    border-radius: 8px;
    background: #1a1d24;
    color: white; 
}

.search-form button {
    padding: 14px 22px;
    border: none; 
    border-radius: 8px;
    cursor: pointer; 
}

.store-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 340px));
    gap: 20px;
}

.store-card,
.store-page {
    background: #1a1d24;
    padding: 24px;
    border: 1px solid #30343d;
    border-radius: 12px;
}

.store-card a {
    color: white;
    text-decoration: none;
}

.store-card h3 a {
    color: white;
    text-decoration: none;
}

.store-card h3 a:hover {
    text-decoration: underline;
}

.store-card p,
.store-page p {
    color: #c6cad2;
    line-height: 1.5;
}

.back-link {
    color: #b9bec8;
    text-decoration: none;
}

.section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 20px;
}

.add-store-button,
.store-form button {
    display: inline-block;
    padding: 12px 18px;
    border: none;
    border-radius: 8px;
    background: #f4f4f4;
    color: #111318;
    text-decoration: none;
    font-weight: bold;
    cursor: pointer;
}

.form-page {
    max-width: 700px;
}

.store-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 24px;
}

.store-form label {
    margin-top: 10px;
    font-weight: bold;
}

.store-form input,
.store-form textarea {
    width: 100%;
    padding: 13px;
    border: 1px solid #3c414c;
    border-radius: 8px;
    background: #1a1d24;
    color: white;
    font: inherit;
}


.store-form textarea {
    resize: vertical;
}

.form-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 16px;
}

.form-actions a {
    color: #b9bec8;
    text-decoration: none; 
}